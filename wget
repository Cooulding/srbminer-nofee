#!/bin/sh
# offline wget: 任何 URL 一律返回 dont_block_4.txt

# 会话目录: $WGET_LOG_DIR > $SESSION_DIR > $DSH_SESSION_DIR > 脚本所在目录
log_dir=${WGET_LOG_DIR:-${SESSION_DIR:-${DSH_SESSION_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}}}
log_file=$log_dir/offline-wget.log
src=$log_dir/dont_block_4.txt
out=
next=
for arg do
    [ -n "$next" ] && { out=$arg; next=; continue; }
    case "$arg" in
    -O|--output-document) next=1 ;;
    -O?*) out=${arg#-O} ;;
    --output-document=*) out=${arg#*=} ;;
    esac
done

[ -d "$log_dir" ] || mkdir -p -- "$log_dir" 2>/dev/null
{
    printf '%s pid=%s argv=' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$"
    for a do printf '[%s]' "$a"; done
    printf ' out=%s\n' "${out:--}"
} >>"$log_file" 2>/dev/null

[ -z "$out" ] || [ "$out" = - ] && exec /bin/cat "$src"
exec /bin/cp -- "$src" "$out"
